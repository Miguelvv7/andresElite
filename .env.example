# Copia este archivo como .env.local. Ninguna de estas variables es obligatoria
# para arrancar la web; cada servicio queda desactivado de forma visible si falta.

# URL pública, sin barra final. Se usa en SEO, sitemap y Open Graph.
NEXT_PUBLIC_SITE_URL=https://tudominio.com

# --- Panel privado (/admin) ---
# Contraseña larga y única. Sin estas dos variables el panel queda desactivado.
ADMIN_PASSWORD=
# Secreto aleatorio para firmar la sesión: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# --- Almacenamiento de producción (Vercel Blob) ---
# Guarda proyectos e imágenes del panel. Sin él, solo se puede editar en local,
# donde se escribe en content/projects.json y public/media/uploads.
BLOB_READ_WRITE_TOKEN=

# --- Streaming de vídeo (Mux: Settings → Access Tokens, permiso Video) ---
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
